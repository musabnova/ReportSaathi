# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key_here

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Server & Deployment Configuration
PORT=8000
# Comma-separated list of allowed frontend origins (e.g., https://reportsaathi.pages.dev,http://localhost:5173), or * for all
ALLOWED_ORIGINS=*

# OCR & Poppler Configuration (Windows paths - not needed in Docker/Linux)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSDATA_PREFIX=C:\Users\musab\tessract\tessdata
# POPPLER_PATH=C:\Program Files\poppler\Library\bin


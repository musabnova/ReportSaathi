# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key_here

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Secret token to secure Telegram webhook updates (header: X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_SECRET_TOKEN=your_optional_webhook_secret_token_here
# Production Webhook URL (e.g., https://your-service.onrender.com).
# When set, the bot runs in Webhook mode. When unset, falls back to Long Polling for local dev.
WEBHOOK_URL=https://your-service.onrender.com
# Set to 'true' to explicitly force Long Polling in local development
TELEGRAM_POLLING=false

# Server & Deployment Configuration
PORT=8000
# Comma-separated list of allowed frontend origins (e.g., https://reportsaathi.pages.dev,http://localhost:5173), or * for all
ALLOWED_ORIGINS=*

# API Rate Limiting Configuration
# Limits per client IP (e.g., '15/minute', '60/hour')
RATE_LIMIT_TEXT=15/minute
RATE_LIMIT_FILE=10/minute
# Number of reverse proxies in front of app (Render = 1, Cloudflare + Render = 2)
FORWARDED_PROXIES_COUNT=1
# Optional Redis URL for distributed rate limiting across multiple containers/workers.
# Defaults to in-memory ("memory://") if unset.
# REDIS_URL=redis://default:password@your-redis-host:6379

# OCR & Poppler Configuration (Windows paths - not needed in Docker/Linux)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSDATA_PREFIX=C:\Users\musab\tessract\tessdata
# POPPLER_PATH=C:\Program Files\poppler\Library\bin

